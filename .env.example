# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- OpenAI (server-side only; never exposed to the browser) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Owner account (single authorized user, no public registration) ---
AUTH_USER_EMAIL=you@example.com
AUTH_USER_NAME=Your Name
# Only used by `npm run seed` to set/reset the login password. Not read at runtime.
ADMIN_PASSWORD=choose-a-strong-passphrase

# --- Security secrets ---
# 32-byte key (base64) for encrypting stored OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Set to true ONLY if this app sits behind a reverse proxy/load balancer
# you control that overwrites X-Forwarded-For / X-Real-IP before requests
# reach it (e.g. Render, Vercel, or nginx/Cloudflare configured to strip
# client-supplied copies). Leave false (the default) if the app is
# directly exposed, so those headers — spoofable by any client — are
# never trusted for rate limiting. On Render specifically: set this to
# true (Render's own load balancer sets these headers correctly).
TRUST_PROXY=false

# --- Storage ---
# Local dev default shown below. On Render, set this to match your
# Persistent Disk's mount path exactly, e.g. DATABASE_PATH=/var/data/app.db
# — see README's "Deploying to Render" section.
DATABASE_PATH=./data/app.db

# --- Gmail (read-only) ---
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console → APIs & Services → Credentials, for a project with the Gmail
# API enabled. Add GOOGLE_OAUTH_REDIRECT_URI below as an authorized
# redirect URI on that client — it must match EXACTLY.
# Leaving these unset keeps Gmail honestly "not connected"; nothing fakes
# a connection without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/gmail/callback

# --- Outlook / Microsoft 365 ---
# Register an app in the Azure Portal → App registrations → New
# registration ("Accounts in any organizational directory and personal
# Microsoft accounts" is fine for personal use). Add a Web platform
# redirect URI matching MICROSOFT_OAUTH_REDIRECT_URI below EXACTLY, and
# create a client secret under Certificates & secrets. Under API
# permissions, add the delegated Microsoft Graph permissions Mail.Read,
# Mail.ReadWrite, Mail.Send, offline_access, openid, profile, email — see
# the README for why each one is requested.
# Leaving these unset keeps Outlook honestly "not connected"; nothing
# fakes a connection without them.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/outlook/callback

# --- Web Push (mobile notifications) ---
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
